{
  "manifest_version": 3,
  "name": "Karpuzikov Browser Debug Bridge",
  "version": "0.1.0",
  "description": "Observe and test MusicBrainz userscripts with private GitHub diagnostic synchronization.",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://musicbrainz.org/*",
    "https://beta.musicbrainz.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Browser Debug Bridge",
    "default_popup": "popup.html"
  }
}
