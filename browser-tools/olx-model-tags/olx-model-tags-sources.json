{
 "sources": [
  {
   "name": "DXOMARK",
   "hosts": [
    "www.dxomark.com"
   ],
   "group": "Smartphones",
   "pages": [
    {
     "path": "^/smartphones/[^/]+/[^/]+/?$",
     "model": {
      "selector": "h1.entry-title"
     },
     "properties": [
      {
       "name": "Year",
       "selector": ".cover .sub-title",
       "transform": "year"
      },
      {
       "name": "DXOMARK",
       "selector": ".scoreBadge.camera .scoreBadgeValue",
       "transform": "digits"
      }
     ]
    },
    {
     "path": "^/smartphones/?$",
     "rows": ".device-row",
     "columns": {
      "headers": ".row.headers .sort-header:not(.rank):not(.device_name)",
      "cells": ".deviceScore",
      "cellValue": ":scope > span"
     },
     "model": {
      "selector": ".deviceName",
      "attribute": "data-device-name"
     },
     "properties": [
      {
       "name": "Year",
       "column": "launch_date",
       "transform": "year"
      },
      {
       "name": "DXOMARK",
       "column": "mobileScore",
       "transform": "digits"
      }
     ]
    }
   ]
  },
  {
   "name": "GSMArena",
   "hosts": [
    "www.gsmarena.com"
   ],
   "group": "Smartphones",
   "pages": [
    {
     "path": "\\.php$",
     "model": {
      "selector": "h1.specs-phone-name-title"
     },
     "properties": [
      {
       "name": "Year",
       "selector": "[data-spec=year]",
       "transform": "year"
      },
      {
       "name": "Display",
       "selector": "[data-spec=displaytype]",
       "transform": "displayType"
      },
      {
       "name": "Battery",
       "selector": "[data-spec=batdescription1]",
       "transform": "batteryMah"
      },
      {
       "name": "Charger",
       "afterLabel": "^Charging$",
       "labels": "#specs-list td.ttl",
       "transform": "chargerPower"
      },
      {
       "name": "NFC",
       "selector": "[data-spec=nfc]",
       "transform": "yesNo"
      }
     ]
    }
   ]
  },
  {
   "name": "Kimovil",
   "hosts": [
    "www.kimovil.com"
   ],
   "group": "Smartphones",
   "pages": [
    {
     "path": "/antutu/?$",
     "model": {
      "fromTitle": "^AnTuTu Benchmark of (.+?)\\s*::"
     },
     "properties": [
      {
       "selector": "[itemprop=\"acceptedAnswer\"] [itemprop=\"text\"]",
       "transform": "antutu"
      }
     ]
    },
    {
     "path": "^/en/(?!.*antutu)",
     "model": {
      "fromTitle": "^(.+?): Price"
     },
     "properties": [
      {
       "name": "Camera Sensor",
       "afterLabel": "^sensor$",
       "labels": "th",
       "transform": "unknownIfEmpty"
      }
     ]
    }
   ]
  },
  {
   "name": "HOCO",
   "hosts": [
    "hocotech.com"
   ],
   "group": "Power banks",
   "pages": [
    {
     "path": "^/product/",
     "whenSelector": ".power-bank-specs-table",
     "model": {
      "selector": "h1.product_title",
      "regex": "[“\"]([^”\"]+)[”\"]",
      "prefix": "Hoco "
     },
     "properties": [
      {
       "name": "Capacity",
       "afterLabel": "^Capacity:$",
       "labels": ".spec-param",
       "regex": "^(\\d+mAh)"
      },
      {
       "name": "Rated capacity",
       "optional": true,
       "afterLabel": "^Capacity:$",
       "labels": ".spec-param",
       "regex": "[Rr]ated capacity:\\s*(\\d+mAh)"
      },
      {
       "name": "Output",
       "afterLabel": "^Output:$",
       "labels": ".spec-param",
       "transform": "maxWatts"
      },
      {
       "name": "Weight",
       "afterLabel": "^Weight:$",
       "labels": ".spec-param",
       "regex": "^(\\d+\\s*g)\\b"
      },
      {
       "name": "Dimensions",
       "afterLabel": "^(Dimensions|Sizes?):$",
       "labels": ".spec-param",
       "regex": "(\\d+(?:\\.\\d+)?\\s*[×x*]\\s*\\d+(?:\\.\\d+)?\\s*[×x*]\\s*\\d+(?:\\.\\d+)?\\s*mm)",
       "transform": "dimensionsMm"
      }
     ],
     "rawSpecs": {
      "rows": ".power-bank-specs-table tbody tr",
      "label": ".spec-param",
      "value": ".spec-value"
     }
    },
    {
     "path": "^/product/",
     "model": {
      "selector": "h1.product_title",
      "regex": "[“\"«]([^”\"»]+)[”\"»]",
      "prefix": "Hoco "
     },
     "properties": [
      {
       "name": "Capacity",
       "selector": ".elementor-widget-woocommerce-product-content p",
       "regex": "(?:\\d+\\.\\s+(?!Rated)[A-Za-z0-9 ]*?|\\b(?<!Rated )(?<!output ))[Cc]apacity\\s*(?:is|:)\\s*(\\d+\\s*mAh)",
       "transform": "batteryMah"
      },
      {
       "name": "Rated capacity",
       "optional": true,
       "selector": ".elementor-widget-woocommerce-product-content p",
       "regex": "Rated (?:output )?capacity:\\s*(\\d+\\s*mAh)",
       "transform": "batteryMah"
      },
      {
       "name": "Output",
       "selector": ".elementor-widget-woocommerce-product-content p",
       "regex": "(?:\\d+\\.\\s+[A-Za-z0-9 ]*?|\\b)[Oo]utput:\\s*([\\s\\S]*?)(?=\\s\\d+\\.\\s[A-Z]|$)",
       "transform": "maxWatts"
      },
      {
       "name": "Weight",
       "selector": ".elementor-widget-woocommerce-product-content p",
       "regex": "[Ww]eight(?:\\s+is(?:\\s+only)?)?:?\\s*(?:main unit\\s*[–-]\\s*)?(\\d+\\s*g)\\b"
      },
      {
       "name": "Dimensions",
       "selector": ".elementor-widget-woocommerce-product-content p",
       "regex": "(?:(?:Sizes?|Dimensions|Length \\* width \\* height)\\s*:?\\s*)?((?:[LWH]\\s*)?\\d+(?:\\.\\d+)?\\s*(?:mm|cm)?\\s*[×x*]\\s*(?:[LWH]\\s*)?\\d+(?:\\.\\d+)?\\s*(?:mm|cm)?\\s*[×x*]\\s*(?:[LWH]\\s*)?\\d+(?:\\.\\d+)?\\s*(?:mm|cm))",
       "transform": "dimensionsMm"
      }
     ],
     "rawSpecs": {
      "text": ".elementor-widget-woocommerce-product-content p",
      "itemRegex": "(?:^|\\s)\\d\\.\\s*([A-Za-z][A-Za-z ]*?):\\s*(.*?)(?=\\s\\d\\.\\s*[A-Za-z][A-Za-z ]*?:|$)"
     }
    }
   ],
   "category": {
    "path": "^/category/.*power-banks/?(page/\\d+/?)?$",
    "products": "[data-widget_type=\"wc-archive-products.default\"] ul.products > li.product",
    "link": "a.woocommerce-LoopProduct-link",
    "next": "a.next.page-numbers",
    "pageLinks": "a.page-numbers"
   }
  },
  {
   "name": "REMAX",
   "hosts": [
    "www.iremax.net"
   ],
   "group": "Power banks",
   "pages": [
    {
     "path": "^/product/\\d+",
     "waitForSelector": "#ProductView p.my-5.text-sm",
     "expandSelector": "#ProductView div.underline.cursor-pointer",
     "model": {
      "selector": "#ProductView .text-\\[32px\\]",
      "prefix": "REMAX "
     },
     "properties": [
      {
       "name": "Capacity",
       "selector": "#ProductView div:has(> p.my-5.text-sm) > p",
       "joinAll": true,
       "regex": "(?:[Tt]ypical [Ee]nergy|(?:[Bb]attery|[Pp]roduct|[Aa]ctual|[Cc]ell) [Cc]apacity):\\s*(?:[Tt]ypical [Ee]nergy:\\s*)?([\\d,]+\\s*mAh)",
       "transform": "batteryMah"
      },
      {
       "name": "Rated capacity",
       "optional": true,
       "selector": "#ProductView div:has(> p.my-5.text-sm) > p",
       "joinAll": true,
       "regex": "^(?:[\\s\\S]*?[Rr]ated [Cc]apacity|(?![\\s\\S]*[Rr]ated [Cc]apacity)[\\s\\S]*?[Rr]ated (?:[Oo]utput|[Ee]nergy)):\\s*≥?\\s*([\\d,]+\\s*mAh)(?!\\s*\\/)",
       "transform": "batteryMah"
      },
      {
       "name": "Output",
       "selector": "#ProductView div:has(> p.my-5.text-sm) > p",
       "joinAll": true,
       "regex": "(?:[Oo]utput (?:[Vv]oltage|[Ss]pecifications|[Pp]ower)[^:：|]*|[Oo]utput)[:：]([\\s\\S]*)$",
       "transform": "peakWatts"
      },
      {
       "name": "Dimensions",
       "optional": true,
       "selector": "#ProductView div:has(> p.my-5.text-sm) > p",
       "joinAll": true,
       "regex": "(?:(?:[Bb]are(?:[- ]?(?:[Mm]achine|[Mm]etal|[Uu]nit|[Bb]ones|bone))?|[Uu]nit|[Pp]roduct|[Ff]inished(?: [Pp]roduct)?|[Nn]et) (?:[Ss]izes?|[Dd]imensions?)|[Dd]imensions of [Bb]are [Uu]nit|[Dd]imensions \\([Uu]nit [Oo]nly\\)|[Ss]ize [Ss]pecifications)[^:：|\\d]*[:：]\\s*((?:\\d+(?:\\.\\d+)?\\s*(?:mm)?\\s*[*×xX]\\s*){2}\\d+(?:\\.\\d+)?\\s*(?:mm|MM|cm)?)",
       "transform": "dimensionsMm"
      },
      {
       "name": "Weight",
       "optional": true,
       "selector": "#ProductView div:has(> p.my-5.text-sm) > p",
       "joinAll": true,
       "regex": "(?:(?:[Bb]are(?:[- ]?(?:[Mm]achine|[Mm]etal|[Uu]nit|[Bb]ones|bone))?|[Uu]nit|[Pp]roduct|[Ff]inished(?: [Pp]roduct)?|[Nn]et) [Ww]eight|[Ww]eight of [Bb]are [Uu]nit|[Ww]eight \\([Uu]nit [Oo]nly\\)|(?:^|\\| |\\d[.,]\\s*)[Ww]eight)[^:：|\\d]*[:：][^|\\d]{0,40}?(\\d+(?:\\.\\d+)?\\s*(?:kg|g)?)(?![\\d.])",
       "transform": "grams"
      }
     ],
     "rawSpecs": {
      "rows": "#ProductView div:has(> p.my-5.text-sm) > p",
      "splitAtColon": true
     }
    }
   ],
   "category": {
    "path": "^/category/%E7%A7%BB%E5%8A%A8%E7%94%B5%E6%BA%90",
    "api": {
     "url": "https://www.iremax.net/api/home/products",
     "language": "EN-US",
     "pageSize": 12,
     "productUrl": "https://www.iremax.net/product/"
    },
    "pageLinks": ".el-pager li.number"
   }
  }
 ]
}
