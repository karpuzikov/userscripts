{
 "sources": [
  {
   "name": "DXOMARK",
   "hosts": [
    "www.dxomark.com"
   ],
   "group": "Smartphones",
   "pages": [
    {
     "path": "^/smartphones/[^/]+/[^/]+/?$",
     "model": {
      "selector": "h1.entry-title"
     },
     "properties": [
      {
       "name": "Year",
       "selector": ".cover .sub-title",
       "transform": "year"
      },
      {
       "name": "DXOMARK",
       "selector": ".scoreBadge.camera .scoreBadgeValue",
       "transform": "digits"
      }
     ]
    },
    {
     "path": "^/smartphones/?$",
     "rows": ".device-row",
     "columns": {
      "headers": ".row.headers .sort-header:not(.rank):not(.device_name)",
      "cells": ".deviceScore",
      "cellValue": ":scope > span"
     },
     "model": {
      "selector": ".deviceName",
      "attribute": "data-device-name"
     },
     "properties": [
      {
       "name": "Year",
       "column": "launch_date",
       "transform": "year"
      },
      {
       "name": "DXOMARK",
       "column": "mobileScore",
       "transform": "digits"
      }
     ]
    }
   ]
  },
  {
   "name": "GSMArena",
   "hosts": [
    "www.gsmarena.com"
   ],
   "group": "Smartphones",
   "pages": [
    {
     "path": "\\.php$",
     "model": {
      "selector": "h1.specs-phone-name-title"
     },
     "properties": [
      {
       "name": "Year",
       "selector": "[data-spec=year]",
       "transform": "year"
      },
      {
       "name": "Display",
       "selector": "[data-spec=displaytype]",
       "transform": "displayType"
      },
      {
       "name": "Battery",
       "selector": "[data-spec=batdescription1]",
       "transform": "batteryMah"
      },
      {
       "name": "Charger",
       "afterLabel": "^Charging$",
       "labels": "#specs-list td.ttl",
       "transform": "chargerPower"
      },
      {
       "name": "NFC",
       "selector": "[data-spec=nfc]",
       "transform": "yesNo"
      }
     ]
    }
   ]
  },
  {
   "name": "Kimovil",
   "hosts": [
    "www.kimovil.com"
   ],
   "group": "Smartphones",
   "pages": [
    {
     "path": "/antutu/?$",
     "model": {
      "fromTitle": "^AnTuTu Benchmark of (.+?)\\s*::"
     },
     "properties": [
      {
       "selector": "[itemprop=\"acceptedAnswer\"] [itemprop=\"text\"]",
       "transform": "antutu"
      }
     ]
    },
    {
     "path": "^/en/(?!.*antutu)",
     "model": {
      "fromTitle": "^(.+?): Price"
     },
     "properties": [
      {
       "name": "Camera Sensor",
       "afterLabel": "^sensor$",
       "labels": "th",
       "transform": "unknownIfEmpty"
      }
     ]
    }
   ]
  },
  {
   "name": "HOCO",
   "hosts": [
    "hocotech.com"
   ],
   "group": "Power banks",
   "pages": [
    {
     "path": "^/product/",
     "model": {
      "selector": "h1.product_title",
      "regex": "[“\"]([^”\"]+)[”\"]",
      "prefix": "Hoco "
     },
     "properties": [
      {
       "name": "Capacity",
       "selector": ".elementor-widget-woocommerce-product-content p",
       "regex": "\\bCapacity:\\s*(\\d+mAh)"
      },
      {
       "name": "Rated capacity",
       "selector": ".elementor-widget-woocommerce-product-content p",
       "regex": "Rated capacity:\\s*(\\d+mAh)"
      },
      {
       "name": "Output",
       "selector": ".elementor-widget-woocommerce-product-content p",
       "regex": "Output:\\s*(.*?)(?=\\s\\d\\.\\s[A-Z]|$)",
       "transform": "maxWatts"
      },
      {
       "name": "Weight",
       "selector": ".elementor-widget-woocommerce-product-content p",
       "regex": "Weight:\\s*(\\d+\\s*g)\\b"
      }
     ]
    }
   ]
  }
 ]
}
